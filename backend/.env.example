# =====================================================================
# Pay pap — backend environment (FastAPI)
# Copy to backend/.env and fill in the values marked <FILL_ME>.
# NEVER commit backend/.env. NEVER send any of these values to the AI model.
# =====================================================================

# ---------- App ----------
APP_ENV=development                 # development | production
APP_BASE_URL=http://localhost:8000  # public URL of this API (Render URL in prod; used for webhook URL)
FRONTEND_URL=http://localhost:3000  # allowed CORS origin
LOG_LEVEL=INFO

# ---------- PayPal (Sandbox only — live payments are out of scope) ----------
# developer.paypal.com > Apps & Credentials > Sandbox > your app
PAYPAL_MODE=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=<FILL_ME>
PAYPAL_CLIENT_SECRET=<FILL_ME>
# Created after you register the webhook URL ({APP_BASE_URL}/webhooks/paypal) in the app settings.
# Subscribe to: PAYMENT.PAYOUTSBATCH.* and PAYMENT.PAYOUTS-ITEM.*
PAYPAL_WEBHOOK_ID=<FILL_ME>
PAYPAL_CURRENCY=USD

# ---------- Supabase ----------
# supabase.com > Project Settings > API
SUPABASE_URL=<FILL_ME>                 # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<FILL_ME>    # server-side only, bypasses RLS
# Project Settings > Database > Connection string (URI). Used for migrations.
DATABASE_URL=<FILL_ME>                 # postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# ---------- AI agent ----------
AI_PROVIDER=groq                       # groq | ollama
GROQ_API_KEY=<FILL_ME>                 # console.groq.com > API Keys (starts with gsk_)
AI_MODEL=                              # empty = provider default (Groq: openai/gpt-oss-120b)
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048
AI_TIMEOUT_SECONDS=60

# ---------- APIMatic Context Plugin (dev-time PayPal API context for the coding agent) ----------
APIMATIC_API_KEY=<FILL_ME>             # optional: only if your plugin setup requires a key

# ---------- Auth (one demo admin + one approver) ----------
JWT_SECRET=<GENERATE: python -c "import secrets;print(secrets.token_urlsafe(48))">
JWT_EXPIRE_MINUTES=480
DEMO_ADMIN_EMAIL=admin@paypap.demo
DEMO_ADMIN_PASSWORD=<FILL_ME>
DEMO_APPROVER_EMAIL=approver@paypap.demo
DEMO_APPROVER_PASSWORD=<FILL_ME>

# ---------- Approval gate ----------
# HMAC key that signs approval records; submit refuses any batch whose approval signature fails.
APPROVAL_SIGNING_SECRET=<GENERATE: python -c "import secrets;print(secrets.token_urlsafe(48))">
APPROVAL_TTL_MINUTES=60                # approval expires if batch not submitted in time

# ---------- Rules engine caps ----------
MAX_AMOUNT_PER_RECIPIENT=1000.00       # per-person cap within one batch
MAX_BATCH_TOTAL=25000.00               # per-batch cap
MAX_BATCH_ITEMS=500                    # PayPal allows up to 15000; keep demo small
SUSPICIOUS_AMOUNT_ZSCORE=3.0           # flag amounts this many std-devs above batch mean
MIN_AMOUNT=0.01

# ---------- Status tracking ----------
STATUS_POLL_INTERVAL_SECONDS=30        # polling fallback when webhooks are delayed
STATUS_POLL_MAX_MINUTES=60
